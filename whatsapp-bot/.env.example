# ---------- WhatsApp Cloud API (Meta) ----------
# From Meta for Developers -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=EAAG...your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Any secret string you choose; enter the same value in the Meta webhook settings
WEBHOOK_VERIFY_TOKEN=choose-a-long-random-string
# App Dashboard -> Settings -> Basic -> App Secret (used to verify webhook signatures)
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

# ---------- Who controls the bot ----------
# Comma-separated. 10-digit Indian numbers get 91 prefixed automatically.
ADMIN_NUMBERS=9636314866
TRIGGER_MESSAGE=Team - Status Query to be Answered
# Messages that switch enquiry mode OFF (comma-separated, case-insensitive)
STOP_MESSAGES=stop,exit,end,done
# Enquiry mode switches itself off after this many hours of inactivity (0 = never)
SESSION_TIMEOUT_HOURS=12

# ---------- Catalogue ----------
# Google Sheet used by index.html (must be shared "Anyone with the link: Viewer")
SHEET_ID=1wcR2TDqy24SALIkHTnwXpLe0RHKeu2EXZoPyraZBtdM
SHEET_NAME=Products
# Optional fallback / alternative: local CSV file or a published-CSV URL
CATALOG_CSV=data/catalog.csv
# How long to cache the catalogue before re-reading the sheet
CATALOG_CACHE_SECONDS=120

# ---------- Purchase options ----------
# Number that receives "Buy Now" / "Enquire" WhatsApp messages
ORDER_WHATSAPP_NUMBER=919928377710
# Public booking page (e.g. your GitHub Pages URL). Used for "View on website".
CATALOG_PAGE_URL=https://preetisuris-web.github.io/Live_Booking/
BUSINESS_NAME=Preeti Suri's
CURRENCY_SYMBOL=₹

PORT=3000
